{
  "manifest_version": 3,
  "name": "Agent Keyring",
  "version": "0.1.0",
  "description": "Fill approved logins in this browser.",
  "key": "",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
