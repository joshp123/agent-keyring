<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>AgentKeyringKeychainGroup</key>
    <string>$(AppIdentifierPrefix)com.joshpalmer.AgentKeyring.shared</string>
    <key>AgentKeyringCloudContainer</key>
    <string>iCloud.com.joshpalmer.AgentKeyring</string>
    <key>NSUserActivityTypes</key>
    <array><string>ASCredentialExchangeActivity</string></array>
    <key>CFBundleDisplayName</key>
    <string>Agent Keyring</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Speak your reply when you deny an agent’s request.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Your spoken reply is turned into text on this iPhone.</string>
    <key>UIBackgroundModes</key>
    <array><string>remote-notification</string></array>
    <key>NSFaceIDUsageDescription</key>
    <string>Use Face ID to approve an agent’s request or sign your reply.</string>
</dict>
</plist>
