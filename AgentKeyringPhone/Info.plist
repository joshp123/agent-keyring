<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>AgentKeyringKeychainGroup</key>
    <string>$(AppIdentifierPrefix)com.joshpalmer.AgentKeyring.shared</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>Agent Keyring join code</string>
            <key>CFBundleURLSchemes</key>
            <array><string>agentkeyring</string></array>
        </dict>
    </array>
    <key>CFBundleDisplayName</key>
    <string>Agent Keyring</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSCameraUsageDescription</key>
    <string>Scan the code on your Mac to add this iPhone.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Speak your reply when you deny an agent’s request.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Your spoken reply is turned into text on this iPhone.</string>
    <key>UIBackgroundModes</key>
    <array><string>remote-notification</string></array>
    <key>NSFaceIDUsageDescription</key>
    <string>Use Face ID to approve an agent’s request or sign your reply.</string>
</dict>
</plist>
